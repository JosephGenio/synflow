{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@synflow/*": ["packages/*"]
    }
  },
  "references": [
    { "path": "./packages/app" },
    { "path": "./packages/server" }
  ]
}
