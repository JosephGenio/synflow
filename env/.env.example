# Environment Configuration Template
# Copy this file to .env.development, .env.staging, or .env.production
# and update with appropriate values for each environment

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=synflow

# ============================================================================
# JWT Authentication Secret
# ============================================================================
# CRITICAL: Generate a secure random string for production
# Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-secure-random-string-here

# ============================================================================
# Email Service Configuration (Brevo/Sendinblue)
# ============================================================================
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Synflow

# ============================================================================
# Application Configuration
# ============================================================================
APP_URL=http://localhost:3000
PORT=3001
NODE_ENV=development
