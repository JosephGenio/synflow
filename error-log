# Export env variables safely (line-by-line to handle special chars in values)
set -a
while IFS='=' read -r key value || [[ -n "$key" ]]; do
  [[ -z "$key" || "$key" =~ ^[[:space:]]*# ]] && continue
  export "$key=$value"
done < env/.env.staging
set +a
# Rebuild containers
docker compose -f docker-compose.staging.yml up -d --build 2>&1
# Wait for backend healthcheck to pass (max 60s)
echo "Waiting for backend to become healthy..."
for i in $(seq 1 12); do
  STATUS=$(docker inspect --format='{{.State.Health.Status}}' synflow-backend-staging 2>/dev/null || echo "missing")
  if [ "$STATUS" = "healthy" ]; then
    echo "Backend is healthy."
    break
  fi
  if [ "$i" = "12" ]; then
    echo "Backend did not become healthy in time."
    docker logs synflow-backend-staging --tail 50
    exit 1
  fi
  echo "  attempt $i/12 — status: $STATUS — waiting 5s..."
  sleep 5
done
echo "Staging ***ment complete."
