{
	"name": "synflow",
	"private": true,
	"version": "0.0.0",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"bootstrap": "pnpm install",
		"dev:app": "pnpm --filter @synflow/app dev",
		"dev:server": "pnpm --filter @synflow/server dev",
		"dev": "concurrently \"pnpm --filter @synflow/server dev\" \"pnpm --filter @synflow/app dev\"",
		"build": "pnpm -w -r build",
		"start:server": "pnpm --filter @synflow/server start",
		"test": "pnpm -r test",
		"health-check": "pnpm test && pnpm eslint . --max-warnings=0",
		"migrate": "pnpm --filter @synflow/server migrate",
		"migrate:rollback": "pnpm --filter @synflow/server migrate:rollback",
		"db:up": "docker compose up -d",
		"db:down": "docker compose down",
		"db:reset": "docker compose down -v && docker compose up -d",
		"prepare": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@eslint/js": "^9.0.0",
		"@types/jest": "^29.0.0",
		"concurrently": "^8.2.0",
		"eslint": "^10.0.0",
		"globals": "^15.0.0",
		"jest": "^29.0.0",
		"ts-jest": "^29.0.0",
		"typescript-eslint": "^8.0.0"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.0",
		"act": "^0.0.6",
		"pnpm": "^10.30.2"
	}
}
